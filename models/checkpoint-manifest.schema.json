{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MWExtract annotation checkpoint bundle",
  "type": "object",
  "required": [
    "schema_version", "model_name", "model_version", "upstream_repository",
    "upstream_commit", "files", "training_datasets", "preprocessing_schema_version",
    "inference_command", "score_direction"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "model_name": {"enum": ["flare", "glacier", "iceberg"]},
    "model_version": {"type": "string"},
    "upstream_repository": {"type": "string"},
    "upstream_commit": {"type": "string"},
    "preprocessing_schema_version": {"const": "1.0.0"},
    "score_direction": {"enum": ["higher", "lower"]},
    "inference_command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["path", "sha256"],
        "properties": {"path": {"type": "string"}, "sha256": {"type": "string"}}
      }
    },
    "training_datasets": {"type": "array"},
    "training_identity_tables": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}

