# Local development configuration.
#
# No LLM API key needed here -- the harness is driven by your own `claude`
# session (Claude Code), billed against your own subscription, not this repo.

# Metabolomics Workbench FTP contact address. The Workbench FTP logs in as
# anonymous and uses this email as the password -- there is no separate
# password. Never logged, never written to any ledger or job file; this
# harness mounts it into the extraction container as a one-off secrets file.
MWB_CONTACT_EMAIL=you@your-institution.edu

# SIRIUS login workspace (optional -- only needed to run the sirius model).
# This harness never handles SIRIUS credentials itself. Create the
# workspace once by hand, per models/README.md:
#   docker run --rm -it --entrypoint sirius \
#     -v /local/sirius-home:/root/.sirius-6.5 \
#     mwannotate-sirius:6.5.4 login -u you@your-institution.edu -p
# then point this at that same host directory (/local/sirius-home above):
# SIRIUS_HOME_DIR=/path/to/sirius-home

# Analysis container concurrency cap (default: 2). Raise this on a machine
# with more GPU/CPU headroom.
# ANALYSIS_MAX_CONCURRENCY=2

# Disk budget guard for fetched studies (defaults: 100GB budget, 50GB reserve).
# DISK_BUDGET_BYTES=100GB
# DISK_RESERVE_BYTES=50GB

# Comma-separated literal browser origins allowed to call this API and read
# the /dashboard/events SSE stream -- needed because the dashboard is a
# separate Next.js app (deployed on Vercel) calling this backend
# cross-origin. Include http://localhost:3000 for local dev.
# ALLOW_ORIGINS=http://localhost:3000,https://your-dashboard.vercel.app

# A single regex (not a list) for origins ALLOW_ORIGINS can't name literally
# -- Vercel's per-branch preview subdomains aren't one fixed URL.
# ALLOW_ORIGIN_REGEX=https://your-dashboard.*\.vercel\.app
